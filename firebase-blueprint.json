{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered user of the NeuroGrowth Labs platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's Firebase Auth UID." },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "A saved AI analysis or query result.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "search", "maps"] },
        "query": { "type": "string" },
        "result": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "query", "result", "createdAt"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "A chat session created for anonymous or logged-in users.",
      "type": "object",
      "properties": {}
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message within a chat session.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "ai", "system"] },
        "text": { "type": "string" },
        "systemPromptContext": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "text", "timestamp"]
    },
    "CourseEnrollment": {
      "title": "Course Enrollment",
      "description": "A learner's enrollment in a free Cybersecurity and AI course.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "progress": { "type": "number" },
        "completed": { "type": "boolean" },
        "enrolledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "courseTitle", "enrolledAt"]
    },
    "CertificateRecord": {
      "title": "Certificate Record",
      "description": "An autogenerated Certificate of Completion issued to a verified learner.",
      "type": "object",
      "properties": {
        "certificateId": { "type": "string" },
        "userId": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "verificationCode": { "type": "string" }
      },
      "required": ["certificateId", "userId", "recipientName", "courseId", "courseTitle", "issuedAt", "verificationCode"]
    },
    "PaperDownloadRecord": {
      "title": "Paper Download Record",
      "description": "A log of an authenticated research paper download.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "paperId": { "type": "string" },
        "paperTitle": { "type": "string" },
        "downloadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "paperId", "paperTitle", "downloadedAt"]
    },
    "CourseReview": {
      "title": "Course Review",
      "description": "Peer reviews and star ratings submitted by authenticated scholars.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "headline": { "type": "string" },
        "reviewText": { "type": "string" },
        "roleTag": { "type": "string" },
        "organization": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "verifiedLearner": { "type": "boolean" },
        "helpfulCount": { "type": "number" },
        "recommendation": { "type": "boolean" }
      },
      "required": ["id", "courseId", "userId", "userName", "rating", "headline", "reviewText", "createdAt"]
    },
    "EmailNotification": {
      "title": "Email Notification",
      "description": "SendGrid transactional email alert logs for course enrollments and certificates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["enrollment", "certificate"] },
        "subject": { "type": "string" },
        "courseId": { "type": "string" },
        "courseCode": { "type": "string" },
        "courseTitle": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "provider": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "type", "subject", "sentAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "analyses/{analysisId}": {
      "schema": { "$ref": "#/entities/Analysis" },
      "description": "Stores saved AI analyses for users."
    },
    "course_enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/CourseEnrollment" },
      "description": "Stores learner course enrollments and progress."
    },
    "certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/CertificateRecord" },
      "description": "Stores accredited certificates of completion."
    },
    "paper_downloads/{downloadId}": {
      "schema": { "$ref": "#/entities/PaperDownloadRecord" },
      "description": "Stores research paper download telemetry."
    },
    "course_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/CourseReview" },
      "description": "Stores course star ratings and peer reviews."
    },
    "email_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/EmailNotification" },
      "description": "Stores transactional email notification logs."
    },
    "chat_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Stores chat sessions.",
      "subcollections": {
        "messages/{messageId}": {
          "schema": { "$ref": "#/entities/ChatMessage" },
          "description": "Stores chat messages."
        }
      }
    }
  }
}
